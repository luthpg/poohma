{
  "name": "poohma",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=@poohma/web",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "check": "biome check --write",
    "check:ci": "biome ci"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "turbo": "^2.5.4",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.21.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.21.0",
      "onFail": "download"
    }
  }
}
