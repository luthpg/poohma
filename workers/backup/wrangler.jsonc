{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "poohma-backup",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["0 18 * * *"]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "r2_buckets": [
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "poohma-backups"
    }
  ],
  "workers_dev": false,
  "preview_urls": false
}
