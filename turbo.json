{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env*"],
  "globalEnv": [
    "NODE_ENV",
    "VERCEL_ENV",
    "CSP_MODE",
    "VITE_*",
    "MICROCMS_*",
    "CONVEX_*",
    "FIREBASE_*",
    "ABSTRACT_IP_GEOLOCATION_API_KEY",
    "SERVER_URL",
    "RESEND_*"
  ],
  "globalPassThroughEnv": ["CI", "VERCEL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".vercel/**", ".output/**", "storybook-static/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "deploy": {
      "cache": false
    }
  }
}
