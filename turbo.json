{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env*"],
  "globalEnv": [
    "NODE_ENV",
    "VERCEL_ENV",
    "CSP_MODE",
    "VITE_*",
    "MICROCMS_*",
    "CONVEX_*",
    "FIREBASE_*",
    "ABSTRACT_IP_GEOLOCATION_API_KEY",
    "SERVER_URL",
    "RESEND_*"
  ],
  "globalPassThroughEnv": [
    "CI",
    "VERCEL",
    "GITHUB_ACTIONS",
    "GITHUB_REF",
    "GITHUB_SHA"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!tests/**",
        "!**/*.spec.*",
        "!**/*.test.*"
      ],
      "outputs": ["dist/**", ".vercel/**", ".output/**"]
    },
    "build-storybook": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["**/*.ts", "**/*.tsx", "tsconfig*.json"]
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!storybook-static/**"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:e2e:show": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "deploy": {
      "cache": false
    }
  }
}
