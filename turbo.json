{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "NODE_ENV",
    "CI",
    "VERCEL",
    "VERCEL_ENV",
    "VITE_*",
    "MICROCMS_*",
    "CONVEX_*",
    "FIREBASE_*",
    "ABSTRACT_IP_GEOLOCATION_API_KEY",
    "SERVER_URL",
    "RESEND_*"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".vercel/**", ".output/**", "storybook-static/**"],
      "passThroughEnv": ["*"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["*"]
    },
    "check": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "deploy": {
      "cache": false
    }
  }
}
