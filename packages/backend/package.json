{
  "name": "@poohma/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "convex dev",
    "deploy": "convex deploy",
    "deploy:dry-run": "convex deploy --dry-run",
    "codegen": "convex codegen",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "preview:setup": "tsx scripts/setup-preview.ts",
    "preview:setup:clean": "tsx scripts/setup-preview.ts --clean",
    "demo:export": "tsx scripts/export-demo-records.ts"
  },
  "exports": {
    "./api": {
      "types": "./convex/_generated/api.d.ts",
      "import": "./convex/_generated/api.js"
    },
    "./dataModel": {
      "types": "./convex/_generated/dataModel.d.ts"
    },
    "./server": {
      "types": "./convex/_generated/server.d.ts",
      "import": "./convex/_generated/server.js"
    }
  },
  "dependencies": {
    "@convex-dev/rate-limiter": "^0.4.2",
    "@poohma/shared": "workspace:*",
    "@react-email/render": "2.1.1",
    "cheerio": "^1.2.0",
    "convex": "^1.47.0",
    "convex-helpers": "^0.1.128",
    "dotenv": "^18.0.8",
    "resend": "^6.34.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "convex-test": "^0.0.63",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "5.0.5"
  }
}
