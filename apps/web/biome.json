{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "root": false,
  "extends": ["../../biome.json"],
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**/src/**/*",
      ".storybook/**/*",
      "*.config.*",
      ".*",
      "tests/**/*",
      "e2e/**/*",
      "scripts/**/*",
      "**/vite.config.ts",
      "!**/src/routeTree.gen.ts",
      "!**/coverage/**/*"
    ]
  },
  "overrides": [
    {
      "includes": ["**/*.spec.{ts,tsx}", "**/*.test.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    }
  ]
}
