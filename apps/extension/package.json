{
  "name": "@poohma/extension",
  "description": "PoohMa Chrome Extension - Family Password & Account Manager",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "check": "biome check --write",
    "check:ci": "biome check",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:bundle": "tsx scripts/verify-bundle-safety.ts",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@poohma/backend": "workspace:*",
    "@poohma/crypto": "workspace:*",
    "@poohma/shared": "workspace:*",
    "@radix-ui/react-slot": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.46.0",
    "firebase": "^12.19.0",
    "lucide-react": "^1.49.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.4",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.0.308",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.2",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2",
    "vitest": "^3.0.7",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
